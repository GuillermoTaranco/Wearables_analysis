sleep_schedule |>
mutate(sleep_date = as.Date(bedtime)) |>
count(sleep_date, name = "total_logs_across_all_users") |>
arrange(sleep_date)
dailyActivity |>
group_by(Activity_intensity) |>
summarise(Minutes=sum(Minutes)) |>
ggplot( aes(x=Activity_intensity, y=Minutes)) +
geom_bar(stat = "identity")
weeklyActivity <-
dailyActivity |>
# Round each date down to the start of its week. For lubridate it starts on Sunday
mutate(Week = floor_date(Date, unit = "week")) |>
# Group by Id and the new unique Week column
group_by(Id, Activity_intensity, Week) |>
# Summarize the minutes
summarise(Total_Minutes = sum(Minutes), .groups = "drop")|>
pivot_wider(
names_from =Activity_intensity,
values_from = Total_Minutes
) |>
mutate(
MixActivity=(Fairly/2 + Very),
Healthy = case_when(
(MixActivity>75) ~ T,
Fairly>150 ~ T,
# Very>75 ~ T, # Si Very + (Fairly/2)  no es mayor que 75. Very + 0 no puede ser mayor de 75
.default = FALSE
)
)
head(weeklyActivity,10)
holeWeek <-
dailyActivity |>
group_by(Id, Week=floor_date(Date, unit = "week")) |>
summarize(days_used = n_distinct(Date)) |>
filter(days_used>6)
weeklyLong <-
weeklyActivity|>
pivot_longer(
cols = c(seq(3,7)),
values_to="Minutes",
names_to="Activity_intensity"
)
weeklyClean <-
weeklyLong |>
filter(Activity_intensity == "MixActivity") |>
inner_join(holeWeek, by = c("Id", "Week"))
# 2. Get a vector of all the unique IDs
notableProfiles <- c(8053475328,
4020332650,
2026352035)
# 3. Loop through each ID and print a distinct chart
for (i in notableProfiles) {
# Filter for just the current ID in the loop
user_data <- clean_data |>
filter(Id == i)
# Build the plot
p <- ggplot(user_data, aes(x = Week, y = Minutes)) +
# Shaded background for the "Healthy" zone
annotate("rect", xmin = as.Date(-Inf), xmax = as.Date(Inf), ymin = 75, ymax = Inf,
fill = "#e5f5e0", alpha = 0.5) +
# The threshold abline
geom_hline(yintercept = 75, linetype = "dashed", color = "#2ca25f", linewidth = 1) +
# Label for the threshold
annotate("text", x = as.Date(-Inf), y = 75, label = " Healthy Goal (75+ Min)",
vjust = -1, hjust = -0.05, color = "#1b7837", fontface = "bold") +
# Connected Scatterplot (restored back to the larger size)
geom_line(color = "#2b8cbe", linewidth = 1.2) +
geom_point(color = "#2b8cbe", fill = "white", size = 3.5, shape = 21, stroke = 1.5) +
# Dynamic title using paste() to show the current ID
labs(
title = paste("Mixed Activity Duration | User ID:", i),
subtitle = "Tracking weekly minutes (Complete 7-day weeks only)",
x = "Week",
y = "Total Minutes"
) +
theme_minimal(base_size = 14) +
theme(
plot.title = element_text(face = "bold", size = 16, color = "#333333"),
plot.subtitle = element_text(size = 12, color = "#666666", margin = margin(b = 15)),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
axis.line.x = element_line(color = "gray80"),
axis.ticks.x = element_line(color = "gray80", linewidth = 0.5)
)
# 4. Explicitly print the plot (required inside loops)
print(p)
}
