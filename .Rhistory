dailyActivity |>
# Round each date down to the start of its week
mutate(Week = floor_date(Date, unit = "week")) |>
# Group by Id and the new unique Week column
group_by(Id, Activity_intensity, Week) |>
# Summarize the minutes
summarise(Total_Minutes = sum(Minutes), .groups = "drop") |>
pivot_wider(
names_from =Activity_intensity,
values_from = Total_Minutes
) |>
mutate(
MixActivity=(Fairly/2 + Very),
Healthy = case_when(
(MixActivity>75) ~ T,
Fairly>150 ~ T,
Very>75 ~ T,
.default = FALSE
)
) |>
mutate(
# 1. Convert the boolean to a factor with both TRUE and FALSE levels
Healthy = factor(Healthy, levels = c(TRUE, FALSE))
) |>
group_by(Id) |>
# 2. Add .drop = FALSE to prevent hiding the zero-count level
count(Healthy, .drop = FALSE)
