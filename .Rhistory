library(tidyverse)
library(DataExplorer)
library(lubridate)
options(scipen = 999)#to not show scientific notation
dailyActivity_merged1<-read_csv(file = "./data/Fitabase Data 3.12.16-4.11.16/dailyActivity_merged.csv")
dailyActivity_merged2<-read_csv(file = "./data/Fitabase Data 4.12.16-5.12.16/dailyActivity_merged.csv")
minuteSleep_merged1<-read_csv(file = "./data/Fitabase Data 3.12.16-4.11.16/minuteSleep_merged.csv")
minuteSleep_merged2<-read_csv(file = "./data/Fitabase Data 4.12.16-5.12.16/minuteSleep_merged.csv")
head(dailyActivity_merged1)
head(dailyActivity_merged2)
head(minuteSleep_merged1)
head(minuteSleep_merged2)
dailyActivity<-
dailyActivity_merged1 |> full_join(dailyActivity_merged2) |>
select(Id, Date=ActivityDate, ends_with("Minutes")) |>
pivot_longer(
cols = ends_with("Minutes"),
names_to = "Activity_intensity",
values_to = "Minutes"
) |>
mutate(
Id = as.character(Id),
Date= mdy(Date),
Activity_intensity = str_remove(Activity_intensity, "Minutes"),
Activity_intensity = str_remove(Activity_intensity, "Active"),
Activity_intensity = factor(Activity_intensity,
levels = c("Sedentary", "Lightly", "Fairly", "Very"))
)
head(dailyActivity)
minuteSleep<-
minuteSleep_merged1 |> full_join(minuteSleep_merged2) |>
select(Id, Date=date,Sleep_state=value, LogId=logId) |>
mutate(
# I don't want one user to seem twice the other. These are quali
Id = as.character(Id),
LogId = as.character(LogId),
Date_time = mdy_hms(Date), # Handles "4/12/2016 2:47:30 AM"
Date = as.Date(Date_time),      # Drops the time, keeps YYYY-MM-DD
# Change 1, 2, 3 into readable ordinal categories
Sleep_state = factor(
Sleep_state,
levels = c(1, 2, 3),                       # Valores originales en los datos
labels = c("Asleep", "Restless", "Awake"), # Nuevas etiquetas de texto
ordered = TRUE                             # Jerarquía: Asleep < Restless < Awake
)
)
head(minuteSleep)
sleepWide<-
minuteSleep |> group_by(Id, Date, Sleep_state) |>
# 4. Count the rows (1 row = 1 minute)
summarize(total_minutes = n(), .groups = "drop")|>
# 5. Pivot wider to create separate columns for Asleep, Restless, and Awake
pivot_wider(
names_from = Sleep_state,
values_from = total_minutes,
values_fill = 0 # Puts a 0 if the user had 0 minutes in a state that day
)
head(sleepWide)
